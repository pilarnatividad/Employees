<mvc:View
	controllerName="com.logaligroup.employees.controller.Details"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
    xmlns:uxap="sap.uxap"
>
    <uxap:ObjectPageLayout >
        <uxap:headerTitle>
           <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="{employees>LastName} {employees>FirstName} ({employees>EmployeeID})"/>
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <Title text="{employees>LastName} {employees>FirstName} ({employees>EmployeeID})"/>
                </uxap:snappedHeading>

                <uxap:expandedContent>
                     <HBox alignItems="Center"
                           justifyContent="SpaceBetween">
                         <HBox >
                            <VBox>
                                <Label text="{i18n>country}:" class="boldElement"/>
                                <Text text="{employees>Country}"/>
                            </VBox>
                         </HBox> 
                         <HBox>
                            <VBox>
                                <Label text="{i18n>city}:" class="boldElement"/>
                                <Text text="{employees>City}"/>
                            </VBox>
                         </HBox> 
                         <HBox>
                            <VBox>
                                <Label text="{i18n>postalCode}:" class="boldElement"/>
                                <Text text="{employees>PostalCode}"/>
                            </VBox>
                         </HBox> 
                     </HBox>

                </uxap:expandedContent>

                <uxap:snappedContent>
                     <HBox alignItems="Center"
                           justifyContent="SpaceBetween">
                         <HBox >
                            <VBox>
                                <Label text="{i18n>country}:" class="boldElement"/>
                                <Text text="{employees>Country}"/>
                            </VBox>
                         </HBox> 
                         <HBox>
                            <VBox>
                                <Label text="{i18n>city}:" class="boldElement"/>
                                <Text text="{employees>City}"/>
                            </VBox>
                         </HBox> 
                         <HBox>
                            <VBox>
                                <Label text="{i18n>postalCode}:" class="boldElement"/>
                                <Text text="{employees>PostalCode}"/>
                            </VBox>
                         </HBox> 
                     </HBox>

                </uxap:snappedContent>

                <uxap:actions>
                    <Button icon="sap-icon://decline"
                            press="onClosePress"
                            type="Reject" />
                </uxap:actions>
           </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:sections>
        
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>