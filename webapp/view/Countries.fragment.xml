<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
     
>
<SelectDialog id="valueHelpDialog" 
              title="{i18n>labelCountry}" 
              items="{countries>/Countries}" 
              search="_handleValueHelpSearch" 
              confirm="_handleValueHelpClose" 
              cancel="_handleValueHelpClose" 
              multiSelect="true">
     <StandardListItem icon="{countries>flag}" iconDensityAware="false" iconInset="false" title="{countries>code}" description="{countries>country}"
                    />
          
</SelectDialog>
</core:FragmentDefinition>


